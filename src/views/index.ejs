<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title><%= title %></title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

:root{
    --bg:#101114;
    --panel:#17181c;
    --panel-2:#1f2025;
    --panel-3:#292b31;
    --line:rgba(255,255,255,.1);
    --line-strong:rgba(255,255,255,.16);
    --text:#f4f4f5;
    --muted:#a1a1aa;
    --soft:#d4d4d8;
    --brand:#10a37f;
    --brand-soft:rgba(16,163,127,.16);
    --shadow:0 24px 80px rgba(0,0,0,.34);
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html,
body{
    height:100%;
    min-height:100%;
}

body{
    font-family:"Inter",system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
    background:
        radial-gradient(circle at top left, rgba(16,163,127,.14), transparent 34rem),
        linear-gradient(135deg,#111214 0%,#17181c 42%,#0f1013 100%);
    color:var(--text);
    overflow:hidden;
}

button,
textarea{
    font:inherit;
}

button{
    border:none;
}

.app-shell{
    position:fixed;
    inset:0;
    width:100%;
    height:100vh;
    height:100dvh;
    min-height:0;
    display:grid;
    grid-template-columns:280px minmax(0,1fr);
    background:rgba(16,17,20,.84);
    overflow:hidden;
}

.sidebar{
    display:flex;
    flex-direction:column;
    border-right:1px solid var(--line);
    background:rgba(23,24,28,.9);
    backdrop-filter:blur(24px);
    min-width:0;
    min-height:0;
}

.brand{
    height:72px;
    display:flex;
    align-items:center;
    gap:12px;
    padding:0 18px;
    border-bottom:1px solid var(--line);
}

.brand-mark,
.avatar{
    width:38px;
    height:38px;
    display:grid;
    place-items:center;
    flex:0 0 auto;
    border-radius:12px;
}

.brand-mark{
    background:linear-gradient(135deg,var(--brand),#4ade80);
    color:#06120f;
    box-shadow:0 14px 30px rgba(16,163,127,.28);
}

.brand-text{
    min-width:0;
}

.brand-title{
    font-size:15px;
    font-weight:700;
    letter-spacing:0;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
}

.brand-subtitle{
    margin-top:3px;
    color:var(--muted);
    font-size:12px;
}

.new-chat{
    margin:16px;
    height:44px;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:10px;
    border:1px solid var(--line-strong);
    border-radius:8px;
    background:var(--panel-2);
    color:var(--text);
    cursor:pointer;
    transition:background .2s ease,border-color .2s ease,transform .2s ease;
}

.new-chat:hover{
    background:var(--panel-3);
    border-color:rgba(255,255,255,.24);
}

.new-chat:active{
    transform:translateY(1px);
}

.sidebar-section{
    padding:8px 12px;
}

.section-label{
    margin:12px 8px 8px;
    color:#8b8f98;
    font-size:11px;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.08em;
}

.hint-list{
    display:grid;
    gap:6px;
}

.hint-item{
    width:100%;
    min-height:40px;
    padding:10px 12px;
    display:flex;
    align-items:center;
    gap:10px;
    border-radius:8px;
    color:var(--soft);
    font-size:13px;
    background:transparent;
    border:1px solid transparent;
    text-align:left;
    cursor:pointer;
    transition:background .2s ease,border-color .2s ease,color .2s ease;
}

.hint-item:hover{
    color:var(--text);
    background:rgba(255,255,255,.05);
    border-color:rgba(255,255,255,.08);
}

.sidebar-footer{
    margin-top:auto;
    padding:16px;
    border-top:1px solid var(--line);
    color:var(--muted);
    font-size:12px;
    line-height:1.55;
}

.chat-panel{
    min-width:0;
    min-height:0;
    height:100%;
    display:grid;
    grid-template-rows:72px minmax(0,1fr) auto;
    overflow:hidden;
}

.topbar{
    height:72px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:18px;
    padding:0 28px;
    border-bottom:1px solid var(--line);
    background:rgba(16,17,20,.72);
    backdrop-filter:blur(20px);
}

.page-title{
    min-width:0;
}

.page-title h1{
    font-size:16px;
    font-weight:700;
    letter-spacing:0;
}

.page-title p{
    margin-top:4px;
    color:var(--muted);
    font-size:12px;
}

.status-pill{
    height:34px;
    display:flex;
    align-items:center;
    gap:8px;
    padding:0 12px;
    border:1px solid rgba(16,163,127,.28);
    border-radius:999px;
    color:#c8f7e8;
    background:var(--brand-soft);
    font-size:12px;
    font-weight:600;
    white-space:nowrap;
}

.status-dot{
    width:8px;
    height:8px;
    border-radius:50%;
    background:var(--brand);
    box-shadow:0 0 0 5px rgba(16,163,127,.13);
}

.chat{
    height:100%;
    min-height:0;
    overflow-y:auto;
    overscroll-behavior:contain;
    padding:34px max(28px,calc((100vw - 1080px) / 2)) 34px;
    scroll-behavior:smooth;
}

.chat::-webkit-scrollbar{
    width:10px;
}

.chat::-webkit-scrollbar-thumb{
    background:#393b42;
    border:3px solid transparent;
    border-radius:999px;
    background-clip:content-box;
}

.chat::-webkit-scrollbar-track{
    background:transparent;
}

.message-row{
    display:grid;
    grid-template-columns:38px minmax(0,850px);
    gap:14px;
    align-items:flex-start;
    margin:0 auto 20px;
    animation:messageIn .22s ease both;
}

.message-row.user-row{
    grid-template-columns:minmax(0,850px) 38px;
    justify-content:end;
}

.avatar{
    margin-top:2px;
    color:var(--text);
    border:1px solid var(--line);
    background:var(--panel-2);
}

.ai-row .avatar{
    background:linear-gradient(135deg,var(--brand),#34d399);
    color:#06120f;
    border-color:transparent;
}

.user-row .avatar{
    grid-column:2;
    background:#303238;
}

.message{
    min-width:0;
    padding:16px 18px;
    border-radius:8px;
    color:var(--text);
    line-height:1.75;
    font-size:15px;
    word-wrap:break-word;
    overflow-wrap:anywhere;
    box-shadow:0 1px 0 rgba(255,255,255,.03) inset;
}

.ai{
    background:rgba(31,32,37,.86);
    border:1px solid var(--line);
}

.user{
    grid-column:1;
    background:var(--brand);
    color:#f8fffc;
    border:1px solid rgba(255,255,255,.12);
}

.typing-cursor::after{
    content:"";
    display:inline-block;
    width:7px;
    height:1.1em;
    margin-left:3px;
    vertical-align:-.18em;
    border-radius:999px;
    background:rgba(244,244,245,.82);
    animation:caret .9s steps(2,start) infinite;
}

.loading-dots{
    display:inline-flex;
    align-items:center;
    gap:5px;
    height:16px;
}

.loading-dots span{
    width:6px;
    height:6px;
    border-radius:50%;
    background:#c9d1d9;
    opacity:.35;
    animation:pulse 1.05s ease-in-out infinite;
}

.loading-dots span:nth-child(2){
    animation-delay:.15s;
}

.loading-dots span:nth-child(3){
    animation-delay:.3s;
}

.composer-wrap{
    position:relative;
    z-index:5;
    padding:18px 28px 24px;
    border-top:1px solid var(--line);
    background:linear-gradient(180deg,rgba(16,17,20,.82),rgba(16,17,20,.98));
}

#chatForm{
    width:100%;
    max-width:900px;
    margin:0 auto;
}

.composer{
    display:grid;
    grid-template-columns:minmax(0,1fr) 46px;
    gap:10px;
    align-items:end;
    padding:10px;
    border:1px solid var(--line-strong);
    border-radius:8px;
    background:rgba(31,32,37,.94);
    box-shadow:var(--shadow);
    transition:border-color .2s ease,box-shadow .2s ease,background .2s ease;
}

.composer:focus-within{
    border-color:rgba(16,163,127,.6);
    box-shadow:0 0 0 4px rgba(16,163,127,.12), var(--shadow);
    background:#222329;
}

textarea{
    width:100%;
    min-height:26px;
    max-height:168px;
    resize:none;
    padding:10px 8px;
    color:var(--text);
    background:transparent;
    border:none;
    outline:none;
    line-height:1.55;
    font-size:15px;
}

textarea::placeholder{
    color:#878b94;
}

.send-button{
    width:46px;
    height:46px;
    display:grid;
    place-items:center;
    border-radius:8px;
    cursor:pointer;
    background:var(--brand);
    color:#06120f;
    transition:background .2s ease,transform .2s ease,opacity .2s ease;
}

.send-button:hover:not(:disabled){
    background:#18bd94;
}

.send-button:active:not(:disabled){
    transform:translateY(1px);
}

.send-button:disabled{
    cursor:not-allowed;
    opacity:.48;
}

.composer-meta{
    max-width:900px;
    margin:10px auto 0;
    color:#848891;
    font-size:12px;
    text-align:center;
}

svg{
    display:block;
}

@keyframes messageIn{
    from{
        opacity:0;
        transform:translateY(8px);
    }
    to{
        opacity:1;
        transform:none;
    }
}

@keyframes caret{
    50%{
        opacity:0;
    }
}

@keyframes pulse{
    0%,80%,100%{
        transform:translateY(0);
        opacity:.3;
    }
    40%{
        transform:translateY(-4px);
        opacity:.9;
    }
}

@media(max-width:980px){
    .app-shell{
        grid-template-columns:1fr;
    }

    .sidebar{
        display:none;
    }
}

@media(max-width:720px){
    .chat-panel{
        grid-template-rows:64px minmax(0,1fr) auto;
    }

    .topbar{
        height:64px;
        padding:0 16px;
    }

    .page-title p{
        display:none;
    }

    .status-pill{
        height:30px;
        padding:0 10px;
    }

    .chat{
        padding:22px 14px 18px;
    }

    .message-row,
    .message-row.user-row{
        grid-template-columns:32px minmax(0,1fr);
        gap:10px;
        margin-bottom:16px;
    }

    .message-row.user-row{
        grid-template-columns:minmax(0,1fr) 32px;
    }

    .avatar{
        width:32px;
        height:32px;
        border-radius:8px;
    }

    .message{
        padding:13px 14px;
        font-size:14px;
        line-height:1.65;
    }

    .composer-wrap{
        padding:12px 12px 16px;
    }

    .composer{
        grid-template-columns:minmax(0,1fr) 42px;
    }

    .send-button{
        width:42px;
        height:42px;
    }

    .composer-meta{
        display:none;
    }
}
</style>
</head>

<body>
<div class="app-shell">
    <aside class="sidebar" aria-label="Assistant sidebar">
        <div class="brand">
            <div class="brand-mark" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                    <path d="M12 3l7.5 4.3v9.4L12 21l-7.5-4.3V7.3L12 3z" stroke="currentColor" stroke-width="1.8"/>
                    <path d="M8.5 12h7M12 8.5v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
            </div>
            <div class="brand-text">
                <div class="brand-title">AI RAG Assistant</div>
                <div class="brand-subtitle">Knowledge retrieval workspace</div>
            </div>
        </div>

        <button class="new-chat" id="newChat" type="button" title="Start a new chat">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            New chat
        </button>

        <div class="sidebar-section">
            <div class="section-label">Quick prompts</div>
            <div class="hint-list">
                <button class="hint-item" type="button" data-prompt="Give me a concise summary of the best matching context.">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M8 7h8M8 12h8M8 17h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    </svg>
                    Summarize context
                </button>
                <button class="hint-item" type="button" data-prompt="Find the most relevant university information for this query.">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M4 19V7l8-4 8 4v12M8 19v-7h8v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    University lookup
                </button>
                <button class="hint-item" type="button" data-prompt="Compare the matching results and explain the differences clearly.">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M7 6h11M7 12h11M7 18h11M4 6h.01M4 12h.01M4 18h.01" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    </svg>
                    Compare results
                </button>
            </div>
        </div>

        <div class="sidebar-footer">
            Responses are generated from the connected RAG pipeline. Review important details before using them.
        </div>
    </aside>

    <main class="chat-panel">
        <header class="topbar">
            <div class="page-title">
                <h1><%= title %></h1>
                <p>Ask questions and get grounded answers from your indexed data.</p>
            </div>
            <div class="status-pill" aria-label="System status">
                <span class="status-dot" aria-hidden="true"></span>
                Ready
            </div>
        </header>

        <section class="chat" id="chat" aria-live="polite">
            <div class="message-row ai-row">
                <div class="avatar" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                        <path d="M12 3l7.5 4.3v9.4L12 21l-7.5-4.3V7.3L12 3z" stroke="currentColor" stroke-width="1.8"/>
                        <path d="M8.5 12h7M12 8.5v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    </svg>
                </div>
                <div class="message ai">Welcome to AI First Project Management System. Ask a question to search your indexed knowledge base.</div>
            </div>
        </section>

        <footer class="composer-wrap">
            <form id="chatForm">
                <div class="composer">
                    <textarea
                        id="prompt"
                        placeholder="Message AI RAG Assistant..."
                        rows="1"
                        required
                    ></textarea>
                    <button class="send-button" id="sendButton" type="submit" title="Send message" aria-label="Send message">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M5 12h13M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                </div>
            </form>
            <div class="composer-meta">Press Enter to send. Use Shift + Enter for a new line.</div>
        </footer>
    </main>
</div>

<script>
const form = document.getElementById("chatForm");
const chat = document.getElementById("chat");
const prompt = document.getElementById("prompt");
const sendButton = document.getElementById("sendButton");
const newChat = document.getElementById("newChat");
const hintButtons = document.querySelectorAll("[data-prompt]");
const initialMessage = "Welcome to AI First Project Management System. Ask a question to search your indexed knowledge base.";

function scrollToBottom() {
    chat.scrollTop = chat.scrollHeight;
}

function resizePrompt() {
    prompt.style.height = "auto";
    prompt.style.height = `${Math.min(prompt.scrollHeight, 168)}px`;
}

prompt.addEventListener("input", resizePrompt);

prompt.addEventListener("keydown", (event) => {
    if (event.key === "Enter" && !event.shiftKey) {
        event.preventDefault();
        form.requestSubmit();
    }
});

hintButtons.forEach((button) => {
    button.addEventListener("click", () => {
        prompt.value = button.dataset.prompt;
        resizePrompt();
        prompt.focus();
    });
});

newChat.addEventListener("click", () => {
    chat.innerHTML = "";
    appendMessage(initialMessage, "ai");
    prompt.value = "";
    resizePrompt();
    prompt.focus();
});

form.addEventListener("submit", async (event) => {
    event.preventDefault();

    const text = prompt.value.trim();
    if (!text || sendButton.disabled) return;

    appendMessage(text, "user");
    prompt.value = "";
    resizePrompt();
    sendButton.disabled = true;

    const loading = appendMessage("", "ai");
    loading.innerHTML = '<span class="loading-dots" aria-label="Thinking"><span></span><span></span><span></span></span>';

    try {
        const response = await fetch("/", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                prompt: text
            })
        });

        const data = await response.json();

        if (!response.ok) {
            throw new Error(data?.error || "Request failed");
        }

        const responseText = data?.answer || data?.error;


        console.log(responseText);

        loading.innerHTML = "";
        typeText(loading, responseText || "No response.");
    } catch (err) {
        loading.classList.remove("typing-cursor");
        loading.textContent = err.message || "Something went wrong. Please try again.";
    } finally {
        sendButton.disabled = false;
        prompt.focus();
        scrollToBottom();
    }
});

function appendMessage(text, type) {
    const row = document.createElement("div");
    row.className = `message-row ${type}-row`;

    const avatar = document.createElement("div");
    avatar.className = "avatar";
    avatar.setAttribute("aria-hidden", "true");
    avatar.innerHTML = type === "ai"
        ? '<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 3l7.5 4.3v9.4L12 21l-7.5-4.3V7.3L12 3z" stroke="currentColor" stroke-width="1.8"/><path d="M8.5 12h7M12 8.5v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>'
        : '<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M20 21a8 8 0 0 0-16 0M12 13a5 5 0 1 0 0-10 5 5 0 0 0 0 10z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';

    const message = document.createElement("div");
    message.className = `message ${type}`;
    message.textContent = text;

    if (type === "user") {
        row.append(message, avatar);
    } else {
        row.append(avatar, message);
    }

    chat.appendChild(row);
    scrollToBottom();
    return message;
}

function typeText(element, text) {
    const words = text.split(" ");
    let index = 0;

    element.classList.add("typing-cursor");

    function type() {
        if (index < words.length) {
            element.textContent += (index === 0 ? "" : " ") + words[index];
            index++;
            scrollToBottom();
            setTimeout(type, 5);
            return;
        }

        element.classList.remove("typing-cursor");
    }

    type();
}
</script>
</body>
</html>
